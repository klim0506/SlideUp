# Пример переменных для локального бэкенда (на хосте) при infra в Docker.
# Скопируйте в .env.local и подставьте значения, либо задайте их в PowerShell перед скриптами.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=slidegen
POSTGRES_USER=slidegen
POSTGRES_PASSWORD=slidegen

REDIS_URL=redis://127.0.0.1:6379/0

DJANGO_SECRET_KEY=change-me-local-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PUBLIC_URL=http://localhost:5173

# Локально с Claude Code CLI: принудительно режим CLI (не зависит от админки).
GENERATION_CLAUDE_MODE=cli

# Не уходить на API, если CLI не найден (ошибка сразу). Иначе при наличии ANTHROPIC_API_KEY будет тихий fallback.
GENERATION_CLI_STRICT=true

# Опционально: только если нужен fallback без CLI
# ANTHROPIC_API_KEY=
